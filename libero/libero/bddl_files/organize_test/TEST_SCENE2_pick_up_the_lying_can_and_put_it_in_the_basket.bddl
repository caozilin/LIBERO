(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the lying can and put it in the basket)
    (:regions
      (basket_init_region
          (:target main_table)
          (:ranges (
              (-0.05 0.1 0.15000000000000002 0.30000000000000004)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_init_region
          (:target main_table)
          (:ranges (
              (-0.25 -0.25 -0.04999999999999999 -0.04999999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    lying_alphabet_soup_1 - lying_alphabet_soup
    basket_1 - basket
  )

  (:obj_of_interest
    lying_alphabet_soup_1
    basket_1
  )

  (:init
    (On lying_alphabet_soup_1 main_table_can_init_region)
    (On basket_1 main_table_basket_init_region)
  )

  (:goal
    (And (In lying_alphabet_soup_1 basket_1_contain_region))
  )

)
